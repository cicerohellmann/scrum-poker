{
  "name": "team-scrum-poker",
  "version": "1.0.0",
  "private": true,
  "description": "A small self-hosted scrum poker app with password-protected rooms.",
  "type": "commonjs",
  "scripts": {
    "start": "node --experimental-sqlite server.js",
    "dev": "node --experimental-sqlite server.js",
    "test": "npm run test:unit && npm run test:layout",
    "test:unit": "node --test tests/*.test.js",
    "test:layout": "playwright test",
    "seed:demo": "node --experimental-sqlite scripts/seed-demo.js"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1"
  }
}
